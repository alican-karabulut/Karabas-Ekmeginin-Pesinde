  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Merhaba Karaba\u015F! Bu macerada amac\u0131n, engelleri a\u015Farak ekme\u011Fe
    ula\u015Fmak ve sonraki b\xF6l\xFCme ge\xE7mek.\r\n\r\nAma dikkatli ol! \xDCzerine
    cisimler d\xFC\u015Febilir, duvarlarla kar\u015F\u0131la\u015Fabilir, zeminler
    hareket edebilir veya aniden kaybolabilir. Tuzaklara yakalan\u0131rsan b\xF6l\xFCm\xFCn
    ba\u015F\u0131na d\xF6nersin!\r\n\r\nHer b\xF6l\xFCmde yeni tehlikelerle kar\u015F\u0131la\u015Fabilirsin.
    Ben de sana bunlarla nas\u0131l ba\u015Fa \xE7\u0131kaca\u011F\u0131n\u0131 anlataca\u011F\u0131m.
    Baz\u0131 b\xF6l\xFCmlerde sorularla da kar\u015F\u0131la\u015Facaks\u0131n.
    Yard\u0131ma ihtiyac\u0131n olursa yan\u0131ma gel, sana bildiklerimi hat\u0131rlatay\u0131m!\r\n\r\nHaydi
    Karaba\u015F, dikkatli ol ve ekme\u011Finin pe\u015Finden git! "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
