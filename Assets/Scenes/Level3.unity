--- !u!1001 &1792561347
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 1156488490643810698, guid: e5854dc8d0893a643af8777f7c8175d7, type: 3}
      propertyPath: m_Name
      value: Canvas
      objectReference: {fileID: 0}
    - target: {fileID: 3926354918133751045, guid: e5854dc8d0893a643af8777f7c8175d7, type: 3}
      propertyPath: m_text
      value: "Vay can\u0131na Karaba\u015F, buraya kadar gelebildiysen ger\xE7ekten
        dikkatlisin demektir! Ama i\u015Fler \u015Fimdi biraz daha k\u0131z\u0131\u015F\u0131yor.
        Kar\u015F\u0131ndaki o devasa, d\xF6nen \u015Feyi g\xF6r\xFCyor musun? O
        bir testere diski ve inan bana hi\xE7 \u015Fakas\u0131 yok!\n\n\xDCstelik
        bundan sonra sadece d\xFC\u015Fen cisimler veya kaybolan zeminler olmayacak;
        bunun gibi hareketli kapanlar ve gizli tuzaklar da yolunu kesecek. Bu keskin
        engelleri a\u015Fmak i\xE7in bazen \xE7ok h\u0131zl\u0131 olmal\u0131, bazen
        de do\u011Fru an\u0131 sab\u0131rla beklemelisin.\n\nHaydi Karaba\u015F,
        testerelerin ritmini \xE7\xF6z ve ekme\u011Fine g\xFCvenle ula\u015F!"
      objectReference: {fileID: 0}
